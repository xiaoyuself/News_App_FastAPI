# ---- 硅基流动（Embedding 向量化，OpenAI 兼容）----
# 申请：https://cloud.siliconflow.cn
SI_API_KEY=sk-xxxxxxxx
SI_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---- DeepSeek（回答生成，OpenAI 兼容）----
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

# ---- 可选：检索置信度阈值（默认 0.6）----
# top1 精排分数低于它，就判断为"知识库没有相关内容"，改走 Multi-Query 或直接兜底。
# 调高 = 更保守（少瞎答，但更容易回"暂无相关信息"）；调低 = 更敢答（但可能答偏）。
# LOW_CONF_THRESHOLD=0.6
