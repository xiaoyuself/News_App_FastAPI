# 依赖与缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.idea/
.vscode/

# 敏感信息：API Key 一律不进仓库
.env
*.env.local

# 本地导出的临时文件
news_app.sql
*.log

# 智能客服的"知识库指纹"（运行时自动生成，各机器不一样，不要进仓库）
.index_meta.json

# 归档的旧资料（不需要进仓库）
_归档/

# 部署 / 测试的临时产物（不属于源码）
_deploy/
_test_pdf/
_scratch/

# 评估基线备份（对比用的中间产物，运行时生成）
*.before.json

# ---------- 以下仅本地/服务器使用，不纳入仓库 ----------
# 部署相关：容器编排与镜像定义（需要时用 git add -f 强制加入）
docker-compose.yml
Dockerfile
.dockerignore
# 数据库结构与初始数据（服务器上单独维护）
database.sql
# 本地文档（部署手册、优化记录）
Docker部署速查手册.md
优化说明.md
