# 依赖与缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.idea/
.vscode/

# 敏感信息：API Key 一律不进仓库
.env
*.env.local

# 本地导出的临时文件
news_app.sql
*.log

# 智能客服的"知识库指纹"（运行时自动生成，各机器不一样，不要进仓库）
.index_meta.json

# 归档的旧资料（不需要进仓库）
_归档/

# 部署 / 测试的临时产物（不属于源码）
_deploy/
_test_pdf/
_scratch/

# 评估基线备份（对比用的中间产物，运行时生成）
*.before.json
